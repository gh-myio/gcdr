# =============================================================================
# config.env — GCDR customer configuration for this directory
#
# Values here override built-in defaults.
# Environment variables (GCDR_API_KEY=... ./script.sh) still take precedence.
# =============================================================================

# API key used by all scripts in this directory
GCDR_API_KEY=gcdr_myio_tenant_bundle_key_2026

# GCDR customer UUID — used by check-inconformidades.sh when device-map files
# don't have gcdrCustomerId filled in column 9.
GCDR_CUSTOMER_ID=a4c64215-f7eb-4102-80b5-e10b98e2f94e

# Fallback asset UUID — used by consolidate-creates.sh when a device has no
# gcdrAssetId in the device-map file (column 10).
DEFAULT_GCDR_ASSET_ID=67a52596-5528-4809-bf9d-3f94c197696f

# Uncomment to target a different environment:
# GCDR_API_URL=https://gcdr-api.a.myio-bas.com
