# =============================================================================
# GCDR API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3015
HOST=0.0.0.0
LOG_LEVEL=debug

# Audit log verbosity: MINIMAL | STANDARD | VERBOSE | DEBUG
AUDIT_LEVEL=STANDARD

# Default tenant when a request carries none (and for seeds/tools).
DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111

# Bypass ALL auth (JWT + API key). DEV/TEST ONLY — NEVER set true in production.
DISABLE_AUTH=false

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_DB=db_gcdr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_PORT=5432

# Connection URL (used by the API)
DATABASE_URL=postgresql://postgres:your-secure-password-here@localhost:5432/db_gcdr

# =============================================================================
# JWT Authentication
# =============================================================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters
JWT_ISSUER=gcdr
JWT_AUDIENCE=gcdr-api
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Work Orders (WO) — field-operator PIN (operator-pin login, RFC-0032)
# =============================================================================
# HMAC pepper used to derive the deterministic lookup token stored in
# users.wo_field_pin_lookup. Bcrypt hashes are layered on top in
# users.wo_field_pin_hash. Rotating this value invalidates ALL stored
# PINs — operators will need to be re-issued PINs from the admin UI.
# Optional: only needed if you use operator-PIN login. The legacy name
# QRC_PIN_PEPPER (pre wo-rename) is still honored as a fallback.
# Generate once: openssl rand -hex 32
WO_PIN_PEPPER=replace-me-32-hex-chars-min-or-server-will-refuse-to-mint-pins

# =============================================================================
# Master API Key (M2M — internal systems, e.g. ThingsBoard provisioning)
# =============================================================================
# Grants full tenant access to ALL protected endpoints.
# Use X-API-Key: <value> + X-Tenant-Id: <tenantId> headers.
# Generate a strong random value: openssl rand -hex 32
# Leave unset to disable master key auth.
GCDR_MASTER_API_KEY=

# =============================================================================
# Alarm Bundle signing (RFC-0015)
# =============================================================================
# HMAC-SHA256 secret that signs alarm bundles (X-Version-Id integrity, consumed
# by Node-RED). If UNSET, a public hardcoded default is used — set a real secret
# in production or bundle signatures are forgeable. Generate: openssl rand -hex 32
BUNDLE_SIGNING_SECRET=

# =============================================================================
# DB Admin UI (/admin/db)
# =============================================================================
# Lightweight DB browser. Keep disabled unless needed; gate with a password.
ENABLE_DB_ADMIN=false
DB_ADMIN_PASSWORD=

# =============================================================================
# CORS
# =============================================================================
# Use * for development, specific domains for production
CORS_ORIGIN=*

# =============================================================================
# Docker Compose
# =============================================================================
# API exposed port
API_PORT=3015

# Build target: production or development
BUILD_TARGET=production

# =============================================================================
# Email (Outlook/Microsoft 365)
# =============================================================================
# SMTP configuration for sending emails
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM_NAME=MyIO Platform
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Email feature toggle (set to false to disable email sending)
EMAIL_ENABLED=true

# =============================================================================
# AWS (Legacy - for DynamoDB during migration)
# =============================================================================
# AWS_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# S3-compatible storage (MYIO Knowledge — RFC-0030 / RFC-0031)
# =============================================================================
# DEV — defaults below talk to the MinIO sidecar in docker-compose.yml.
# PROD — run scripts/aws/provision-knowledge-bucket.sh to create the bucket
#        and a least-privilege IAM user; paste the resulting access key here.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=myio-knowledge-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_MAX_BYTES=10485760

# =============================================================================
# Cloudflare Turnstile (public wiki integration submission anti-bot)
# =============================================================================
# Secret key from the Turnstile dashboard at https://dash.cloudflare.com.
# Pair this with VITE_TURNSTILE_SITE_KEY in the frontend env.
# If unset, server-side captcha verification is bypassed (dev only — set it in
# prod to actually enforce bot protection on /public/wiki/integrations/submit).
TURNSTILE_SECRET_KEY=

# =============================================================================
# GCDR Copiloto (RFC-0043) - read-only LLM assistant over the Work Order tools
# =============================================================================
# Anthropic API key used by POST /assistant. If unset, the assistant endpoint
# returns 503 and the UI shows the "unavailable" state (the rest of the app is
# unaffected). Model is overridable; defaults to claude-sonnet-4-6.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-6
