# =============================================================================
# orchestrator-devices worker — environment (RFC-0062 §14)
#
# Non-secret defaults for the Dokploy worker container. SECRETS (DATABASE_URL,
# ALARMS_API_TOKEN) are provided by the Dokploy environment/secrets at deploy
# time and are NOT committed here.
#
# IMPORTANT — the SAFETY switches are NOT here. shadow_mode / canonical_writes /
# incident_emission / sanity / debounce live in the DB table
# `orchestrator_devices_control` (scope='FLAGS'), which migration 0070 seeds SAFE
# (shadow on, canonical off, incident off). The DB row is AUTHORITATIVE and is
# read at the top of every tick; env cannot accidentally enable writes. Flip the
# live switches per the runbook (docs/ops/RFC-0062-orchestrator-devices-runbook.md).
# =============================================================================

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
# DATABASE_URL — provided as a Dokploy SECRET (same 'database-url' the API uses):
# DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/db_gcdr

# ── Safety (boot fallback only; the DB control table is authoritative) ────────
# MASTER boot default — used ONLY if the MASTER control row is absent. The row is
# seeded (enabled=false), so this stays false for defence-in-depth.
ORCH_DEVICES_MASTER_ENABLED=false

# ── Scheduling / intervals ────────────────────────────────────────────────────
# Worker loop cadence (the scheduler tick). Per-central due-time is derived from
# check_interval_seconds below + jitter.
ORCH_DEVICES_TICK_INTERVAL_MS=60000
# Project-default probe cadence per central (each central may override via its
# check_interval_seconds column). 900s = 15 min.
CENTRAL_CHECK_INTERVAL_SECONDS=900
# Deterministic +/- spread on the interval so probes don't burst (thundering herd).
CENTRAL_CHECK_JITTER_PCT=20
# Max centrals processed per scan.
SCAN_BATCH_SIZE=500
# How many central probes run concurrently within a sweep (keep below the DB pool).
# Bounded concurrency keeps a full-fleet sweep short so the heartbeat never goes stale.
ORCH_DEVICES_PROBE_CONCURRENCY=8
# Re-stamp the heartbeat DURING a running tick (must stay well under HEALTHCHECK_MAX_STALE_MS).
ORCH_DEVICES_HEARTBEAT_INTERVAL_MS=30000
# Minutes without a successful sync before a failing central is proposed OFFLINE
# (held DEGRADED before that).
ORCH_DEVICES_OFFLINE_GRACE_MIN=5

# ── Probe timeouts / retry ────────────────────────────────────────────────────
# Per-attempt bounded timeout (a hung gateway must not stall the scan).
CENTRAL_PROBE_TIMEOUT_MS=5000
# Hard cap on a retry policy's total wall-time (Σ delays + timeouts) per central.
CENTRAL_PROBE_MAX_TOTAL_MS=120000
# Retry policy name from the orchestrator_retry_policies book (strict|default|lenient);
# each central may override via its retry_policy column.
CENTRAL_DEFAULT_RETRY_POLICY=default

# ── Gateway probe target (OUR endpoints) ──────────────────────────────────────
# {id} is substituted with the central's hardware UUID.
CENTRAL_TUNNEL_HOST_TEMPLATE=https://{id}.y.myio.com.br
CENTRAL_PROBE_PATH=/v2/slaves
# Optional shared token sent as X-Status-Token (leave unset if not required):
# CLOUD_STATUS_TOKEN=

# ── ALARMS incidents (optional; emission also gated by the DB incident_emission flag) ──
# When ALARMS_API_URL is UNSET, incident candidates are logged as dry-run and never
# POSTed. Set both (token via Dokploy SECRET) only after validating ALARMS, then flip
# incident_emission_enabled in the DB FLAGS row.
# ALARMS_API_URL must be the ALARMS ingestion base INCLUDING /api/v1 — the worker
# posts to {ALARMS_API_URL}/incidents/candidates (RFC-0031):
# ALARMS_API_URL=https://<alarms-host>/api/v1
# ALARMS_API_TOKEN=  (Dokploy secret — never committed, never logged)

# ── Bundle cache flush after canonical apply (Monitor D, RFC-0062 §11c) ───────
# When the rules-monitor auto-mutes/restores a device it mutates rules.scope_entity_ids
# and must force the API to regenerate the NO_CONSUMPTION bundle — the bundle cache is a
# PER-PROCESS in-memory Map, so the worker can't clear the API's copy from here. It calls
# the API's authenticated flush endpoint after commit:
#   DELETE {GCDR_API_URL}/customers/{id}/alarm-rules/bundle/cache   (bundles:read key)
# Best-effort: a flush failure is logged and NEVER undoes the committed mute/restore — the
# 300s cache TTL is the guaranteed backstop. When GCDR_API_URL/KEY are UNSET the worker
# runs TTL-only (no flush). Single-replica API only (a multi-replica API behind a LB would
# need shared/versioned invalidation — a targeted flush reaches just one instance).
# GCDR_API_URL must include /api/v1:
# GCDR_API_URL=https://<gcdr-host>/api/v1
# GCDR_BUNDLE_FLUSH_API_KEY=  (Dokploy secret — bundles:read scope; never committed/logged)
# ORCH_DEVICES_BUNDLE_FLUSH_TIMEOUT_MS=4000
# ORCH_DEVICES_BUNDLE_FLUSH_RETRIES=2

# ── Healthcheck ───────────────────────────────────────────────────────────────
# The container healthcheck fails if MASTER.last_run_at is older than this
# (default 3× the 60s tick). Catches a crashed or hung worker.
HEALTHCHECK_MAX_STALE_MS=180000
